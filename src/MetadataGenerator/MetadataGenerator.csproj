<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
<!--    <RuntimeIdentifiers>linux-arm64;linux-x64;osx-arm64;win-arm64;win-x64</RuntimeIdentifiers>-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp.PInvokeGenerator" Version="21.1.8.4" />
    <PackageReference Include="libclang" Version="21.1.8" />
    <PackageReference Include="libClangSharp" Version="21.1.8.2" />
    <PackageReference Include="libclang.runtime.win-x64" Version="21.1.8" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="21.1.8.2" />
  </ItemGroup>

  <PropertyGroup>
    <LibClangName Condition="'$(LibClangName)' == ''">libclang</LibClangName>
    <LibClangSharpName Condition="'$(LibClangSharpName)' == ''">libClangSharp</LibClangSharpName>
  </PropertyGroup>

  <!-- Auto-detect LLVM... more or less -->
  <PropertyGroup Condition="'$(LLVMIncludePath)' == ''">
    <LLVMIncludePath Condition="'$(OS)' == 'Windows_NT'">C:\Program Files\LLVM\include</LLVMIncludePath>
    <LLVMIncludePath Condition="'$(OS)' != 'Windows_NT'">/usr/lib/llvm-20/include</LLVMIncludePath>
  </PropertyGroup>

</Project>
