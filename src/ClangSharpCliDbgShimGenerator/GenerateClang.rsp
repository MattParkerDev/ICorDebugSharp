--generate
enum-operators=false
aggressive-inlining
callconv-member-function
cpp-attributes
disable-runtime-marshalling
file-scoped-namespaces
guid-member
macro-bindings
marker-interfaces
native-inheritance-attribute
setslastsystemerror-attribute
unmanaged-constants
vtbl-index-attribute
helper-types
enum-member-type-name=false
generated-code=none
--log
potential-typedef-remappings
exclusions
--config
file=multi
codegen=preview
vtbls=trimmable
types=windows
--library-path
dbgshim
--namespace
ICorDebugSharp
--method-class-name
DbgShimNative
--output
../ICorDebugSharp/GeneratedMetadata
--header-file
Header.txt
--remap
_GUID=Guid
